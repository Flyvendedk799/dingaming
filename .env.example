# ---------------------------------------------------------------------------
# DinGaming frontend environment
# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust for your environment.
#
# LOCAL DEVELOPMENT (default, see .env):
#   VITE_SUPABASE_URL=http://127.0.0.1:54321
#   VITE_SUPABASE_PUBLISHABLE_KEY=<the ANON_KEY printed by `supabase status`>
#
# PRODUCTION / HOSTED SUPABASE:
#   VITE_SUPABASE_URL=https://<project-ref>.supabase.co
#   VITE_SUPABASE_PUBLISHABLE_KEY=<your project's anon / publishable key>

VITE_SUPABASE_URL="http://127.0.0.1:54321"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
VITE_SUPABASE_PROJECT_ID="dingaming"

# ---------------------------------------------------------------------------
# Backend / edge function secrets (NOT read by the frontend).
# Set these with `supabase secrets set ...` for a hosted project, or in
# `supabase/.env` for local function development. See docs/LOCAL_DEV.md.
# ---------------------------------------------------------------------------
# KINGUIN_API_KEY=            # enables real game-key fulfillment (optional locally)
# STRIPE_SECRET_KEY=          # enables real Stripe payments (left unset = dev mode)
# STRIPE_WEBHOOK_SECRET=      # for verifying Stripe webhook signatures
# STRIPE_PUBLISHABLE_KEY=     # returned to the client to mount Stripe Elements
