# ---------------------------------------------------------------------------
# Edge function secrets (LOCAL development)
# ---------------------------------------------------------------------------
# Copy to `supabase/.env` (git-ignored) and fill in as needed. The local stack
# reads this file when serving functions. Everything is OPTIONAL locally — with
# nothing set, payments are simulated and fulfillment generates demo keys.
#
# For a HOSTED project set these with: supabase secrets set KEY=value
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by the
# Supabase runtime — do NOT set them here.

# Kinguin (real game catalogue + key fulfillment)
KINGUIN_API_KEY=
KINGUIN_WEBHOOK_SECRET=

# Stripe (payments). Leave unset for dev-mode simulated payments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
